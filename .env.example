# Supabase (Project settings → API). Service role key is server-only.
SUPABASE_URL=https://ihlznxbluyajpikdmmxp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vaani AI (app.vaanivoice.ai) — we generate this; it goes in the webhook URL as ?token=…
# (Vaani AI doesn't sign webhooks). Generate: openssl rand -hex 24
VAANI_WEBHOOK_SECRET=

# HubSpot private app token (scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write,
# crm.schemas.contacts.write, crm.schemas.deals.write, crm.objects.owners.read). Calls use the same contacts scopes.
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_NEW=
HUBSPOT_STAGE_CLAIMED=
HUBSPOT_STAGE_BOOKED=
HUBSPOT_STAGE_NOT_FIT=
HUBSPOT_STAGE_CONSULTED=
HUBSPOT_STAGE_PROPOSAL=
HUBSPOT_STAGE_WON=
HUBSPOT_STAGE_LOST=

HUBSPOT_PORTAL_ID=
HUBSPOT_APP_HOST=app.hubspot.com
