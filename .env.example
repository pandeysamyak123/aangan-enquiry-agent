# Supabase (Project settings → API). Service role key is server-only.
SUPABASE_URL=https://ihlznxbluyajpikdmmxp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vaani AI (app.vaanivoice.ai) — we generate this; it goes in the webhook URL as ?token=…
# (Vaani AI doesn't sign webhooks). Generate: openssl rand -hex 24
VAANI_WEBHOOK_SECRET=

# HubSpot private app token (scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write,
# crm.schemas.contacts.write, crm.schemas.deals.write, crm.objects.owners.read). Calls use the same contacts scopes.
HUBSPOT_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_NEW=
HUBSPOT_STAGE_CLAIMED=
HUBSPOT_STAGE_BOOKED=
HUBSPOT_STAGE_NOT_FIT=

# Telegram (@BotFather). Chat ids: designers group, Nikhil's DM.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DESIGNERS_CHAT_ID=
TELEGRAM_NIKHIL_CHAT_ID=

# Resend
RESEND_API_KEY=
EMAIL_FROM=Aangan Studio <hello@yourdomain.in>
NIKHIL_EMAIL=
DESIGNERS_EMAIL=

# Calendly (personal access token + the "Aangan Consultation" event type URI)
CALENDLY_TOKEN=
CALENDLY_EVENT_TYPE_URI=
CALENDLY_WEBHOOK_SIGNING_KEY=

# Dashboard + cron
DASHBOARD_PASSWORD=
CRON_SECRET=
APP_URL=https://aangan-enquiry-agent-green.vercel.app
# Vaani AI voice rate in paise per billable minute (from your Vaani plan) — used for cost on the dashboard
VAANI_PAISE_PER_MIN=240

# Vaani AI API key (Developers → API Key). Used by scripts/vaani-agent.ts to create/update the agent.
VAANI_API_KEY=
VAANI_AGENT_ID=
